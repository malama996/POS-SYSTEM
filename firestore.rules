rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function shop(shopId) { return get(/databases/$(database)/documents/shops/$(shopId)); }
    function member(shopId) { return get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)); }
    function isOwner(shopId) { return signedIn() && shop(shopId).data.ownerUid == request.auth.uid; }
    function isMember(shopId) { return signedIn() && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)); }
    function canManage(shopId) { return isOwner(shopId) || (isMember(shopId) && member(shopId).data.role in ['admin','manager']); }

    // A shop is created only by its authenticated owner. All other access
    // requires an explicit membership document; there is no public access.
    match /shops/{shopId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(shopId) || isOwner(shopId);
      allow update: if canManage(shopId) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(shopId);

      match /sales/{saleId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow create: if isMember(shopId) && request.resource.data.cashierUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /members/{userId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        // The owner may bootstrap their own membership. All other member
        // administration belongs in a trusted Admin SDK / Cloud Function.
        allow create: if isOwner(shopId) && userId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
